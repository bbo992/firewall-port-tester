{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Firewall port tester configuration",
  "description": "Actual environment settings must remain in ignored *.local.json files. IPv4/TCP only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "company_cidrs",
    "ssh",
    "machines"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "company_cidrs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "description": "Exact company public source IPv4 network in strict CIDR notation; /0 is prohibited.",
        "pattern": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}/(?:[1-9]|[12][0-9]|3[0-2])$"
      }
    },
    "ssh": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "user": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_-]{0,31}$"
        },
        "key_file": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      },
      "required": [
        "user",
        "key_file"
      ]
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ttl_seconds": {
          "type": "integer",
          "minimum": 120,
          "maximum": 7200,
          "default": 3600
        },
        "connect_timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 15,
          "default": 3
        },
        "attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "default": 2
        },
        "public_ip_url": {
          "type": "string",
          "pattern": "^https://",
          "default": "https://api.ipify.org"
        }
      }
    },
    "machines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "host"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
          },
          "host": {
            "type": "string",
            "format": "ipv4"
          },
          "ssh": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "user": {
                "type": "string",
                "pattern": "^[a-z_][a-z0-9_-]{0,31}$"
              },
              "key_file": {
                "type": "string",
                "minLength": 1
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            }
          },
          "world_ports": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "uniqueItems": true,
            "maxItems": 256,
            "description": "Expected accessible from both company and external networks."
          },
          "company_ports": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "uniqueItems": true,
            "maxItems": 256,
            "description": "Expected accessible only from company networks."
          },
          "blocked_ports": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "uniqueItems": true,
            "maxItems": 256,
            "description": "Expected blocked from both sources; a temporary listener is still required."
          }
        }
      }
    }
  },
  "$comment": "Runtime validation additionally enforces IPv4/CIDR correctness, at least one port per machine, unique names/hosts, disjoint policies and exclusion of the SSH management port."
}
